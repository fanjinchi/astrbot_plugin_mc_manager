[
  {
    "name": "list",
    "syntax": "list [uuids]",
    "desc": "查看当前在线玩家列表",
    "level": 0,
    "cat": "info"
  },
  {
    "name": "help",
    "syntax": "help [命令名]",
    "desc": "查看命令帮助（RCON 下为控制台视角，价值有限）",
    "level": 0,
    "cat": "info"
  },
  {
    "name": "seed",
    "syntax": "seed",
    "desc": "查看世界种子（敏感信息，部分服务器不公开）",
    "level": 2,
    "cat": "info"
  },
  {
    "name": "locate",
    "syntax": "locate structure|biome|poi <目标>",
    "desc": "查找最近的结构/生物群系/兴趣点坐标，如 locate structure village",
    "level": 2,
    "cat": "info"
  },
  {
    "name": "datapack",
    "syntax": "datapack list|enable|disable [包名]",
    "desc": "管理数据包，datapack list 查看已启用列表",
    "level": 2,
    "cat": "info"
  },
  {
    "name": "kick",
    "syntax": "kick <玩家> [原因]",
    "desc": "踢出玩家（可重新进服）",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "ban",
    "syntax": "ban <玩家> [原因]",
    "desc": "封禁玩家（无法进服，直到 pardon 解封）",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "ban-ip",
    "syntax": "ban-ip <玩家或IP> [原因]",
    "desc": "按IP封禁（危险命令，插件默认拦截）",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "pardon",
    "syntax": "pardon <玩家>",
    "desc": "解除玩家封禁",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "pardon-ip",
    "syntax": "pardon-ip <IP>",
    "desc": "解除IP封禁",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "banlist",
    "syntax": "banlist [players|ips]",
    "desc": "查看封禁名单",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "op",
    "syntax": "op <玩家>",
    "desc": "给予玩家OP（管理员）权限",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "deop",
    "syntax": "deop <玩家>",
    "desc": "移除玩家的OP权限",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "whitelist",
    "syntax": "whitelist on|off|add|remove|list|reload",
    "desc": "白名单管理：on开启后只有名单内玩家能进服；add/remove维护名单；list查看",
    "level": 3,
    "cat": "player"
  },
  {
    "name": "setidletimeout",
    "syntax": "setidletimeout <分钟>",
    "desc": "设置玩家闲置多久后被自动踢出",
